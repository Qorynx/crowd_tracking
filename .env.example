# Production profile and optional local application overrides.
PIPELINE_CONFIG=configs/pipeline-classroom-template.yaml
CLASSROOM_PIPELINE_CONFIG=configs/pipeline-classroom-template.yaml
GENDER_MODEL_PATH=artifacts/gender_classifier/face_gender_classifier_mobilenet_v3_large.pth

# Demo API/session capacity.
API_MAX_LIVE_SESSIONS=1
API_SESSION_TTL_SECONDS=600
API_WARM_ON_START=true
LIVE_STREAM_EVERY_SECONDS=0.15

# Optional self-hosted WebRTC STUN server. Leave empty to disable STUN.
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
# Optional TURN relay for mobile/carrier NAT. Keep these values on the backend;
# the browser receives a short-cached /api/v1/webrtc/ice-config response.
WEBRTC_TURN_SERVERS=
# Preferred for coturn --use-auth-secret: the backend creates expiring HMAC
# credentials and never returns this shared secret to the browser.
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
WEBRTC_TURN_USER_ID=crowd-live
# Alternative for managed TURN providers that issue a username/password.
# Do not configure these together with WEBRTC_TURN_SHARED_SECRET.
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Set true on serverless deployments so every peer is owned by the persistent
# /api/v1/webrtc/connect WebSocket call.
WEBRTC_REQUIRE_LIFECYCLE_SOCKET=false

# Explicit browser origins for FastAPI CORS. Comma-separated in production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Modal sets false; keep true for local Vite development.
FRONTEND_INCLUDE_LOCAL_ORIGINS=true
