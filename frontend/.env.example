# Leave empty for same-origin requests (/api). Vite proxies these requests
# to the local FastAPI server during development.
# Production FE deployments must set this to the public backend origin,
# for example https://api.example.com. Leave empty for local Vite proxy mode.
VITE_API_BASE_URL=

# Optional local API target for the Vite development proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
